#!/bin/bash
#BSUB -J biome_am_02_gather
#BSUB -P acc_DiseaseGeneCell
#BSUB -q premium
#BSUB -n 2
#BSUB -W 02:00
#BSUB -R rusage[mem=8000]
#BSUB -R span[hosts=1]
#BSUB -o logs/02_gather.%J.stdout
#BSUB -eo logs/02_gather.%J.stderr
#BSUB -L /bin/bash
# =============================================================================
# 02_gather.lsf — non-array gather: verify all 22 per-chr outputs exist, then
# concatenate to intermediate/<cohort>/am_annotated.tsv (single header).
# Submitted by submit_cohort*.sh with bsub -w "done(biome_am_02)".
#
# Required env: COHORT, CONFIG_PATH
# =============================================================================
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
source "$REPO_ROOT/lib/common.sh"
source "$REPO_ROOT/lib/load_modules.sh"

CONFIG_PATH="${CONFIG_PATH:-$REPO_ROOT/config/config.yaml}"
export CONFIG_PATH
cd "$REPO_ROOT"

: "${COHORT:?must set COHORT=cohortI or cohortII}"
INTERMED="$(cfg_get paths.intermediate_dir)/${COHORT}"
log "02_gather: cohort=$COHORT under $INTERMED"

# Independent re-verification — do NOT trust upstream -w "done(...)"
gather_verify_22 "$INTERMED" "{chr}.am_annotated.tsv"

OUT="${INTERMED}/am_annotated.tsv"
log "concatenating 22 per-chr TSVs -> $OUT"
HEADER_WRITTEN=0
> "$OUT"
TOTAL=0
for i in $(seq 1 22); do
    f="${INTERMED}/chr${i}.am_annotated.tsv"
    if [[ "$HEADER_WRITTEN" -eq 0 ]]; then
        head -n 1 "$f" >> "$OUT"
        HEADER_WRITTEN=1
    fi
    body_n="$(tail -n +2 "$f" | wc -l | awk '{print $1}')"
    TOTAL=$((TOTAL + body_n))
    tail -n +2 "$f" >> "$OUT"
done
log "02_gather: cohort=$COHORT total data rows=$TOTAL -> $OUT"
