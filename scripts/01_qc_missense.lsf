#!/bin/bash
#BSUB -J biome_am_01[1-22]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q premium
#BSUB -n 8
#BSUB -W 08:00
#BSUB -R rusage[mem=16000]
#BSUB -R span[hosts=1]
#BSUB -o logs/01_qc_missense.%J.%I.stdout
#BSUB -eo logs/01_qc_missense.%J.%I.stderr
#BSUB -L /bin/bash
# =============================================================================
# 01_qc_missense.lsf — array [1-22], dual-mode (per_chr_input | sliced_from_combined).
#
# Required env vars (set by submit_cohortI.sh / submit_cohortII.sh):
#   COHORT          : "cohortI" or "cohortII"
#   CONFIG_PATH     : path to config.yaml (defaults to repo_root/config/config.yaml)
#
# Output: intermediate/<cohort>/chr<N>.qc.vcf.gz  (+ .csi)
# Per-(cohort,chr) QC counts in/out written to logs/01_qc_missense.<jobid>.<arr>.stdout
# =============================================================================
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
# When bsub reads this file via stdin (`bsub ... < script.lsf`), LSF runs
# the script from /local/JOBS/.../shell and HERE/.. resolves to /local. So
# we have FOUR fallbacks, in priority order:
#   1) $BIOAM_REPO_ROOT  (set by submit_*.sh wrappers via -env)
#   2) $LS_SUBCWD        (LSF's submission CWD, when -env "all" didn't propagate)
#   3) $PWD              (LSF normally preserves CWD; works for most stdin invocations)
#   4) $HERE/..          (direct invocation: `bash scripts/01_qc_missense.lsf`)
# Print every candidate up front so failures are immediately diagnosable.
printf '[REPO_ROOT debug] BIOAM_REPO_ROOT=%q  LS_SUBCWD=%q  PWD=%q  HERE=%q\n' \
    "${BIOAM_REPO_ROOT:-}" "${LS_SUBCWD:-}" "${PWD:-}" "${HERE:-}" >&2
REPO_ROOT=""
for cand in "${BIOAM_REPO_ROOT:-}" "${LS_SUBCWD:-}" "${PWD:-}" "${HERE:+$HERE/..}"; do
    [[ -n "$cand" && -d "$cand/lib" && -f "$cand/lib/common.sh" ]] || continue
    REPO_ROOT="$(cd "$cand" && pwd)"
    break
done
if [[ -z "$REPO_ROOT" ]]; then
    echo "ERROR: cannot find repo root. None of BIOAM_REPO_ROOT / LS_SUBCWD / PWD / HERE/.." >&2
    echo "       contain lib/common.sh. Set BIOAM_REPO_ROOT=/path/to/repo and re-submit." >&2
    exit 1
fi
echo "[REPO_ROOT] using: $REPO_ROOT" >&2
source "$REPO_ROOT/lib/common.sh"
source "$REPO_ROOT/lib/load_modules.sh"

CONFIG_PATH="${CONFIG_PATH:-$REPO_ROOT/config/config.yaml}"
export CONFIG_PATH
cd "$REPO_ROOT"

: "${COHORT:?must set COHORT=cohortI or cohortII}"
CHR_IDX="${LSB_JOBINDEX:-${TEST_CHR_IDX:-1}}"
CHR="chr${CHR_IDX}"
log "01_qc_missense: cohort=$COHORT chr=$CHR  jobid=${LSB_JOBID:-local} array=${LSB_JOBINDEX:-NA}"

MODE="$(cfg_get "cohorts.${COHORT}.mode")"
[[ -n "$MODE" ]] || die "cohorts.${COHORT}.mode not set in config"
INTERMED="$(cfg_get paths.intermediate_dir)/${COHORT}"
mkdir -p "$INTERMED" "$REPO_ROOT/logs"

# Variant mode: "snv" (default; AM/Chen path — SNV-only) or "all" (ClinVar path —
# keep indels/MNVs, add bcftools norm). Controlled by QC_VARIANT_MODE env so the
# default behaviour (and every existing caller) is unchanged.
VARIANT_MODE="${QC_VARIANT_MODE:-snv}"
if [[ "$VARIANT_MODE" == "all" ]]; then
    OUT_VCF="${INTERMED}/${CHR}.qc_allvar.vcf.gz"
else
    OUT_VCF="${INTERMED}/${CHR}.qc.vcf.gz"
fi
log "variant mode: ${VARIANT_MODE}  ->  $(basename "$OUT_VCF")"
BED="$(cfg_get paths.refs_dir)/target_genes.exons.bed"
[[ -s "$BED" ]] || die "exon BED missing or empty: $BED  (run scripts/00_prepare_refs.sh)"

# build the bcftools setGT failure expression (single source of truth)
QC_EXPR="$(build_qc_expr \
    "$(cfg_get qc.min_dp)" \
    "$(cfg_get qc.min_gq)" \
    "$(cfg_get qc.ab_lo)" \
    "$(cfg_get qc.ab_hi)")"
log "QC mask expression: ${QC_EXPR}"

# ---- resolve input ----------------------------------------------------------
case "$MODE" in
    per_chr_input)
        VCF_DIR="$(cfg_get cohorts.${COHORT}.vcf_dir)"
        PATTERN="$(cfg_get cohorts.${COHORT}.vcf_pattern)"
        IN_VCF="${VCF_DIR}/${PATTERN//\{chr\}/${CHR}}"
        ;;
    sliced_from_combined)
        SRC="$(cfg_get cohorts.${COHORT}.combined_vcf)"
        LOCAL_DIR="$(cfg_get cohorts.${COHORT}.local_source_dir)"
        case "$LOCAL_DIR" in /*) ;; *) LOCAL_DIR="$REPO_ROOT/$LOCAL_DIR";; esac
        # the symlink (in our writable dir) lives alongside its .csi index
        IN_VCF="$LOCAL_DIR/$(basename "$SRC")"
        [[ -e "$IN_VCF" && -s "${IN_VCF}.csi" ]] \
            || die "Cohort II local symlink/index missing under $LOCAL_DIR  (submit index_cohortII_source.lsf first; submit_cohortII.sh handles this)"
        ;;
    *)
        die "unknown mode for $COHORT: $MODE  (expected per_chr_input or sliced_from_combined)"
        ;;
esac
[[ -s "$IN_VCF" ]] || die "input VCF not found / empty: $IN_VCF"
log "input VCF: $IN_VCF"

# ---- guards -----------------------------------------------------------------
log "guard: gVCF check"
guard_not_gvcf "$IN_VCF"

# ---- VCF-convention auto-detect & per-job BED build ------------------------
# Cohort I (Regeneron) uses no-`chr` contigs and FILTER='.'; cohort II uses
# `chr` prefix and FILTER='PASS'. Detect at run time so the same script works.
PFX="$(vcf_chrom_prefix "$IN_VCF")"   # "chr" or ""
CHROM_VCF="${PFX}${CHR_IDX}"           # "chr17" or "17"
log "VCF chrom convention: prefix=${PFX:-<none>}  region='${CHROM_VCF}'"

JOB_BED="${INTERMED}/${CHR}.target.bed"
if [[ "$PFX" == "chr" ]]; then
    cp "$BED" "$JOB_BED"
else
    awk 'BEGIN{FS=OFS="\t"} { sub(/^chr/, "", $1); print }' "$BED" > "$JOB_BED"
fi

PASS_FLAG=""
if [[ "$(cfg_get qc.filter_pass_only)" == "True" || "$(cfg_get qc.filter_pass_only)" == "true" ]]; then
    if vcf_filter_has_pass "$IN_VCF"; then
        PASS_FLAG="-f PASS"
    else
        warn "FILTER column has no PASS values in $(basename "$IN_VCF"); treating '.' as PASS (file is presumed pre-filtered upstream)"
    fi
fi

# ---- pre-counts -------------------------------------------------------------
log "counting input records (region-restricted)"
N_IN_SITE="$(bcftools view -H -r "$CHROM_VCF" -R "$JOB_BED" "$IN_VCF" 2>/dev/null | wc -l | awk '{print $1}')"
log "  records in ${CHROM_VCF} overlapping target BED: ${N_IN_SITE}"
log "  FILTER values present: $(bcftools query -f '%FILTER\n' -r "$CHROM_VCF" "$IN_VCF" 2>/dev/null | sort -u | tr '\n' ',' | sed 's/,$//')"

# ---- multiallelic guard (only inside our BED region; faster) ----------------
log "guard: multiallelic check (within target BED)"
bcftools view -H -r "$CHROM_VCF" -R "$JOB_BED" "$IN_VCF" 2>/dev/null \
    | awk -F'\t' '$5 ~ /,/ {bad=$1":"$2" "$4"/"$5; exit 1} END{ if (bad) print bad > "/dev/stderr" }' \
    || die "multiallelic record encountered in ${CHROM_VCF}; pipeline requires biallelic"

# ---- pipeline: region + FILTER -> mask failing GTs -> bgzip ----------------
log "running QC pipeline (mode=${VARIANT_MODE})"
if [[ "$VARIANT_MODE" == "all" ]]; then
    # ClinVar path: keep ALL variant types (indels/MNVs), left-normalize against
    # the reference FASTA so indels match ClinVar's representation. If no FASTA
    # is configured, skip norm (SNVs still exact; indels best-effort) with a warn.
    REF_FASTA="$(cfg_get references.reference_fasta 2>/dev/null || echo '')"
    case "$REF_FASTA" in /*) ;; "") ;; *) REF_FASTA="$REPO_ROOT/$REF_FASTA";; esac
    if [[ -n "$REF_FASTA" && -s "$REF_FASTA" ]]; then
        log "left-normalizing against reference: $REF_FASTA"
        bcftools view -r "$CHROM_VCF" -R "$JOB_BED" $PASS_FLAG -Ou "$IN_VCF" \
            | bcftools norm -f "$REF_FASTA" -Ou - \
            | bcftools +setGT - -- -t q -n . -i "$QC_EXPR" \
            | bcftools view -Oz -o "$OUT_VCF" -
    else
        warn "references.reference_fasta unset/missing; skipping norm for ClinVar all-variant QC — indel matching is best-effort only"
        bcftools view -r "$CHROM_VCF" -R "$JOB_BED" $PASS_FLAG -Ou "$IN_VCF" \
            | bcftools +setGT - -- -t q -n . -i "$QC_EXPR" \
            | bcftools view -Oz -o "$OUT_VCF" -
    fi
else
    bcftools view -r "$CHROM_VCF" -R "$JOB_BED" $PASS_FLAG -Ou "$IN_VCF" \
        | bcftools view -e 'TYPE!="snp"' -Ou - \
        | bcftools +setGT - -- -t q -n . -i "$QC_EXPR" \
        | bcftools view -Oz -o "$OUT_VCF" -
fi

bcftools index --csi -f "$OUT_VCF"

# ---- post-counts -----------------------------------------------------------
N_OUT_SITE="$(bcftools view -H "$OUT_VCF" 2>/dev/null | wc -l | awk '{print $1}')"
N_OUT_CARRIER_LIKE="$(bcftools query -f '[%GT\n]' "$OUT_VCF" 2>/dev/null \
    | awk '$1 != "./." && $1 != ".|." && $1 != "0/0" && $1 != "0|0" && $1 != "." {n++} END{print n+0}')"
log "  records out (SNV+QC-masked): ${N_OUT_SITE}"
log "  carrier-like genotypes after QC mask: ${N_OUT_CARRIER_LIKE}"
log "  output: $OUT_VCF (+ .csi)"
log "01_qc_missense: cohort=$COHORT chr=$CHR DONE"
